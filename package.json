{
  "name": "pilarapi",
  "version": "1.0.0",
  "description": "PilarAPI — Clean Architecture with Vertical Slices, SOLID, TDD and Value Objects",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint \"src/**/*.{ts,js}\" --max-warnings=0",
    "lint:types": "tsc --noEmit",
    "verify": "npm run lint:types && npm run lint && npm test",
    "start": "node dist/presentation/server.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "pilarapi",
    "solid",
    "clean-architecture",
    "tdd",
    "typescript",
    "portfolio",
    "ddd"
  ],
  "author": "ridho",
  "license": "MIT"
}
